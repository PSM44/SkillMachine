{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SKILLSMACHINE.UPDATE.MANIFEST.schema.json",
  "title": "SkillsMachine Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "update_id",
    "update_version",
    "source_commit",
    "created_at",
    "minimum_project_version",
    "maximum_project_version",
    "reversible",
    "human_approval_required",
    "affected_components",
    "operations",
    "rollback_contract"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "update_id": {
      "type": "string",
      "pattern": "^SM-UPD-[0-9]{6}$"
    },
    "update_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "minimum_project_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "maximum_project_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.(?:[0-9]+|x)$"
    },
    "reversible": { "type": "boolean", "const": true },
    "human_approval_required": { "type": "boolean", "const": true },
    "affected_components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["skills", "grcs", "usecases", "registries", "metadata"]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "action",
          "source_path",
          "target_path",
          "expected_pre_hash",
          "expected_post_hash",
          "backup_required",
          "reversible"
        ],
        "properties": {
          "operation_id": { "type": "string", "minLength": 1 },
          "action": {
            "type": "string",
            "enum": ["ADD", "REPLACE", "DELETE"]
          },
          "source_path": { "type": ["string", "null"] },
          "target_path": { "type": "string", "minLength": 1 },
          "expected_pre_hash": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "expected_post_hash": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "backup_required": { "type": "boolean" },
          "reversible": { "type": "boolean", "const": true }
        },
        "allOf": [
          {
            "if": {
              "properties": { "action": { "const": "ADD" } }
            },
            "then": {
              "properties": {
                "expected_pre_hash": { "type": "null" },
                "expected_post_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "source_path": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "if": {
              "properties": { "action": { "const": "REPLACE" } }
            },
            "then": {
              "properties": {
                "expected_pre_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "expected_post_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "source_path": { "type": "string", "minLength": 1 },
                "backup_required": { "const": true }
              }
            }
          },
          {
            "if": {
              "properties": { "action": { "const": "DELETE" } }
            },
            "then": {
              "properties": {
                "expected_pre_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "expected_post_hash": { "type": "null" },
                "source_path": { "type": "null" },
                "backup_required": { "const": true }
              }
            }
          }
        ]
      }
    },
    "rollback_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "verify_hashes", "restore_baseline"],
      "properties": {
        "mode": {
          "type": "string",
          "const": "CHECKPOINT_AND_INVERSE_PLAN"
        },
        "verify_hashes": { "type": "boolean", "const": true },
        "restore_baseline": { "type": "boolean", "const": true }
      }
    }
  }
}