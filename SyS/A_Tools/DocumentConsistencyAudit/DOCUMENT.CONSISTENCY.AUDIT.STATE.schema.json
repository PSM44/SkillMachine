{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DOCUMENT.CONSISTENCY.AUDIT.STATE.schema.json",
  "title": "Document Consistency Audit State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_root",
    "session_continue_count",
    "focused_audit_count",
    "full_audit_count",
    "next_full_audit_due_session_number",
    "unresolved_conflict_count",
    "unresolved_doubt_count",
    "audit_trigger_history"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "project_root": { "type": "string", "minLength": 1 },
    "session_continue_count": { "type": "integer", "minimum": 0 },
    "focused_audit_count": { "type": "integer", "minimum": 0 },
    "full_audit_count": { "type": "integer", "minimum": 0 },
    "last_focused_audit_at": { "type": ["string", "null"] },
    "last_full_audit_at": { "type": ["string", "null"] },
    "next_full_audit_due_session_number": { "type": "integer", "minimum": 1 },
    "last_audit_result": { "enum": ["PASS", "CONFLICTS_FOUND", "BLOCKED", null] },
    "unresolved_conflict_count": { "type": "integer", "minimum": 0 },
    "unresolved_doubt_count": { "type": "integer", "minimum": 0 },
    "audit_trigger_history": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
